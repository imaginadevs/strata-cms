# Binaries
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Backend
backend/tmp/
backend/*.env

# Premium / closed-source plugins — kept in a SEPARATE PRIVATE repo and checked
# out here (git submodule) only for premium builds (go build -tags premium).
# The OSS repo never contains these, so a plain install needs no private auth.
backend/internal/premium/
backend/cmd/server/premium.go



# Frontend
frontend/dist/

# Embedded SPA (placeholder is committed; production assets are copied at build)
backend/internal/infrastructure/static/dist/*
!backend/internal/infrastructure/static/dist/placeholder
frontend/node_modules/
frontend/.env.local

# Environment
.env
.env.local
.env.*.local

