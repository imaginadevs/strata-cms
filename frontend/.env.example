# Copy to .env for local dev. Values here are placeholders (no secrets).

# Backend the dev proxy forwards /api to.
VITE_API_URL=http://localhost:8080

# Shared gateway secret — must match the backend's GATEWAY_API_KEY.
# Generate one, e.g.:  openssl rand -hex 32
VITE_GATEWAY_KEY=

# (No tenant var — the tenant is derived from the host you visit, so one
# deployment stays multi-tenant.)
