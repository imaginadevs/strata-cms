# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0

# ── Database (PostgreSQL only) ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cms
DB_USER=cms
DB_PASSWORD=cms_secret
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-must-be-at-least-32-chars
# Encrypts secrets at rest in the DB (e.g. a tenant's own S3 secret key).
# Falls back to JWT_SECRET when unset. Changing it makes existing ciphertext
# unreadable — rotate deliberately.
SECRETS_ENCRYPTION_KEY=
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=168h

# ── SSO — Logto ────────────────────────────────────────────────────────────────
ENABLE_SSO=false
LOGTO_ENDPOINT=https://your-tenant.logto.app
LOGTO_APP_ID=your-app-id
LOGTO_APP_SECRET=your-app-secret
LOGTO_REDIRECT_URI=http://localhost:8080/api/auth/sso/callback

# ── Kafka (optional — uses in-memory bus when disabled) ────────────────────────
ENABLE_KAFKA=false
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PREFIX=cms

# ── Super admin — platform account ────────────────────────────────────────────
# The super admin lives in the PLATFORM tenant (the single tenant flagged
# is_platform; by default the bootstrap 'default' tenant). On every start the
# account is ensured in that tenant's schema: created if missing, otherwise only
# re-flagged super-admin (its password is never reset — remove the password var
# after first start). Leave both empty to skip seeding (no one can manage tenants
# until a super admin exists). Regular per-tenant admins are NOT super admins.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-immediately

# Optional: the domain the platform tenant answers on, so the super admin can
# sign in there in production (tenant resolution is by Host → tenants.domain).
# Applied to the platform tenant on startup. Leave empty to keep its current
# domain (the 'default' tenant uses localhost for development).
PLATFORM_DOMAIN=

# ── Super admin — IP whitelist (comma-separated IPs or CIDRs) ─────────────────
# Super admins can navigate across all tenants.
# Access is ONLY granted from these IPs. Empty = super-admin login disabled.
# This value is NEVER stored in the database.
SUPER_ADMIN_ALLOWED_IPS=127.0.0.1,::1

# ── File storage — global S3-compatible bucket (Wasabi) ───────────────────────
# One bucket for all tenants. Files are stored under tenants/{id}/{collection}/{uuid}.ext
# so tenants are isolated by key prefix. The bucket is PRIVATE (Wasabi has public
# buckets disabled): the CMS serves private files via short-lived presigned URLs,
# and files flagged public via the image CDN below.
S3_ENDPOINT=https://s3.us-east-1.wasabisys.com   # Wasabi region endpoint (required for Wasabi); empty for AWS S3
S3_REGION=us-east-1
S3_BUCKET=my-cms-files
S3_ACCESS_KEY_ID=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false          # set true for MinIO
S3_MAX_UPLOAD_MB=25                 # per-file upload size cap
# When the bucket is shared with other apps, namespace this CMS's objects under
# a prefix: keys become {prefix}/tenants/{id}/{collection}/{uuid}.ext. Empty = none.
S3_KEY_PREFIX=

# Public files are served through this image/transform CDN (origin = the bucket above).
# URL shape: {CDN}/{bucket}/{basename}?originalPath={key}  (website appends &w=&fmt=webp&q=)
# Leave empty to serve public files via presigned URLs too.
S3_CDN_BASE_URL=https://images.imaginahosting.com
S3_PUBLIC_BASE_URL=                 # optional direct public prefix (unused when bucket is private)

# ── Features ───────────────────────────────────────────────────────────────────
ENABLE_GRAPHQL=true
ENABLE_REST=true
