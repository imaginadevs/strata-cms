# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0

# ── Database (PostgreSQL only) ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cms
DB_USER=cms
DB_PASSWORD=cms_secret
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-must-be-at-least-32-chars
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=168h

# ── SSO — Logto ────────────────────────────────────────────────────────────────
ENABLE_SSO=false
LOGTO_ENDPOINT=https://your-tenant.logto.app
LOGTO_APP_ID=your-app-id
LOGTO_APP_SECRET=your-app-secret
LOGTO_REDIRECT_URI=http://localhost:8080/api/auth/sso/callback

# ── Kafka (optional — uses in-memory bus when disabled) ────────────────────────
ENABLE_KAFKA=false
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PREFIX=cms

# ── Super admin — first-run seed ──────────────────────────────────────────────
# On first start, if no super admin exists, one is created from these values.
# After the account is created you can (and should) remove SUPER_ADMIN_PASSWORD.
# Subsequent starts skip creation even if the vars are still set.
# Leave both empty to skip automatic seed (you can create the account manually).
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-immediately

# ── Super admin — IP whitelist (comma-separated IPs or CIDRs) ─────────────────
# Super admins can navigate across all tenants.
# Access is ONLY granted from these IPs. Empty = super-admin login disabled.
# This value is NEVER stored in the database.
SUPER_ADMIN_ALLOWED_IPS=127.0.0.1,::1

# ── File storage — global S3-compatible bucket ────────────────────────────────
# One bucket for all tenants. Files are stored under tenants/{id}/collection/uuid.ext
# S3 shards by key-prefix hash internally — same performance as per-tenant buckets.
# Tenants can optionally override with their own bucket via Settings → File Storage.
S3_ENDPOINT=                       # leave empty for AWS S3; set for MinIO/R2
S3_REGION=us-east-1
S3_BUCKET=my-cms-files
S3_ACCESS_KEY_ID=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=                # optional CDN prefix (e.g. https://cdn.example.com)
S3_FORCE_PATH_STYLE=false          # set true for MinIO

# ── Features ───────────────────────────────────────────────────────────────────
ENABLE_GRAPHQL=true
ENABLE_REST=true
